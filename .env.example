# Copy this file to .env and fill in your own values. Never commit .env.

# DVSA MOT History API: registration lookup (make, model, fuel, engine size, mileage)
# https://documentation.history.mot.api.gov.uk/mot-history-api/register
MOT_API_KEY=
MOT_CLIENT_ID=
MOT_CLIENT_SECRET=
MOT_TOKEN_URL=

# Optional: DVLA Vehicle Enquiry Service, adds the CO2 figure for a better MPG estimate
# https://register-for-ves.driver-vehicle-licensing.api.gov.uk/
DVLA_API_KEY=

# UK Government Fuel Finder: live forecourt prices
# https://www.developer.fuel-finder.service.gov.uk/access-latest-fuelprices
FUEL_FINDER_CLIENT_ID=
FUEL_FINDER_CLIENT_SECRET=

# Optional
# PORT=3000
# FUEL_REFRESH_MINUTES=60
# ALLOWED_ORIGIN=https://your-username.github.io
